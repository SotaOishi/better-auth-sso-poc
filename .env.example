# HTTPS Configuration
# Requires mkcert certificates in /certs directory
USE_HTTPS=true

# IdP Server (packages/idp)
PORT=3000
IDP_URL=https://auth.localtest.me:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/better_auth_sso_poc
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-here
BETTER_AUTH_URL=https://auth.localtest.me:3000
IDP_CORS_ORIGINS=https://a.localtest.me:3001,https://b.localtest.me:3002
IDP_REDIRECT_ALLOWED_ORIGINS=https://a.localtest.me:3001,https://b.localtest.me:3002

# App A (packages/app-a)
# Run `pnpm --filter @better-auth-sso-poc/idp run seed` to get CLIENT_ID and CLIENT_SECRET
APP_A_PORT=3001
APP_A_URL=https://a.localtest.me:3001
APP_A_CLIENT_ID=<from-seed-script>
APP_A_CLIENT_SECRET=<from-seed-script>

# App B (packages/app-b)
# Run `pnpm --filter @better-auth-sso-poc/idp run seed` to get CLIENT_ID and CLIENT_SECRET
APP_B_PORT=3002
APP_B_URL=https://b.localtest.me:3002
APP_B_CLIENT_ID=<from-seed-script>
APP_B_CLIENT_SECRET=<from-seed-script>

# E2E overrides (optional; defaults use the URL values above)
E2E_IDP_URL=https://auth.localtest.me:3000
E2E_APP_A_URL=https://a.localtest.me:3001
E2E_APP_B_URL=https://b.localtest.me:3002
