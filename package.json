{
  "name": "better-auth-sso-poc",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "dev:idp": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" pnpm --filter @better-auth-sso-poc/idp run dev",
    "dev:app-a": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" pnpm --filter @better-auth-sso-poc/app-a run dev",
    "dev:app-b": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" pnpm --filter @better-auth-sso-poc/app-b run dev",
    "build": "pnpm -r run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @better-auth-sso-poc/idp run db:generate",
    "db:migrate": "pnpm --filter @better-auth-sso-poc/idp run db:migrate",
    "seed:orgs": "pnpm --filter @better-auth-sso-poc/idp run seed:orgs",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "test:e2e": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" playwright test --config=e2e/playwright.config.ts",
    "test:e2e:headed": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" playwright test --config=e2e/playwright.config.ts --headed"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/cli": "0.1.17",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "concurrently": "9.2.1",
    "typescript": "7.0.2",
    "wait-on": "9.1.0"
  }
}
