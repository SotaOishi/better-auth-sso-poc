{
  "name": "@better-auth-sso-poc/idp",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @better-auth-sso-poc/shared build",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "prestart": "pnpm --filter @better-auth-sso-poc/shared build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx src/scripts/seed-clients.ts",
    "seed:orgs": "tsx src/scripts/seed-organizations.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@better-auth-sso-poc/shared": "workspace:*",
    "@better-auth/drizzle-adapter": "1.7.0-rc.2",
    "@better-auth/oauth-provider": "1.7.0-rc.2",
    "@hono/node-server": "2.0.11",
    "better-auth": "1.7.0-rc.2",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.1"
  }
}
