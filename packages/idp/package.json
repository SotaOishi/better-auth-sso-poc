{
  "name": "@better-auth-sso-poc/idp",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx src/scripts/seed-clients.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@better-auth-sso-poc/shared": "workspace:*",
    "@better-auth/drizzle-adapter": "1.5.0",
    "@better-auth/oauth-provider": "1.5.0",
    "@hono/node-server": "1.19.9",
    "better-auth": "1.5.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.1",
    "hono": "4.12.4",
    "postgres": "3.4.8"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.9",
    "tsx": "4.21.0"
  }
}
