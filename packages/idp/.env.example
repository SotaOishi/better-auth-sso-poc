PORT=3000
USE_HTTPS=true
IDP_URL=https://auth.localtest.me:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/better_auth_sso_poc

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-here
BETTER_AUTH_URL=https://auth.localtest.me:3000
IDP_CORS_ORIGINS=https://a.localtest.me:3001,https://b.localtest.me:3002
IDP_REDIRECT_ALLOWED_ORIGINS=https://a.localtest.me:3001,https://b.localtest.me:3002

# OAuth client redirect URI sources used by the seed script
APP_A_URL=https://a.localtest.me:3001
APP_B_URL=https://b.localtest.me:3002
